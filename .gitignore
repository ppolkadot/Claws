# ---- Dependencies and build output ------------------------------------------------
node_modules/
dist/
src-tauri/target/
src-tauri/gen/
*.tsbuildinfo
# Compiled helpers for the Node test runner (npm run test:queue).
.test-build/
__pycache__/

# ---- Fonts ------------------------------------------------------------------------
# Keep optional local font checkouts out of version control. Polaris sources and
# the bundled web fonts in src/assets/fonts/ (plus public/fonts/LICENSE.txt) are project assets.
assets/fonts/*
!assets/fonts/polaris/
Salted-Flutters-Polaris/

# ---- Design tooling ---------------------------------------------------------------
# Impeccable's machine-generated sidecar, hook cache and review captures.
.impeccable/

# ---- Secrets and signing material -------------------------------------------------
# Nothing in the repo needs these today; a release pipeline would add them.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.jks
tauri-signing*.key*

# ---- Local tool and editor state --------------------------------------------------
.claude/settings.local.json
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~

# ---- OS clutter -------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# ---- Logs and crash dumps ---------------------------------------------------------
*.log
npm-debug.log*
*.dmp
